{
  "tasks": {
    "start": "deno run --allow-read=../data/deu_eng_table.csv.gz --allow-net=127.0.0.1 main.ts --no-browser",
    "start:browser": "deno run --allow-read=../data/deu_eng_table.csv.gz --allow-net=127.0.0.1 --allow-run=xdg-open main.ts",
    "terminal": "deno run --allow-read=../data/deu_eng_table.csv.gz terminal.ts",
    "check": "deno check main.ts terminal.ts",
    "test": "deno test",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "verify": "deno task fmt --check && deno task lint && deno task check && deno task test"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 100
  }
}
